# Shell-compatible example. The server does not load this file automatically.
SITE_HOST=127.0.0.1
SITE_PORT=8080
# Use an absolute directory outside the checkout on the VPS.
SITE_DATA_DIR=./runtime-data
SITE_PUBLIC_URL=http://127.0.0.1:8080
# Generate privately: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
SITE_API_TOKEN=
# Optional absolute overrides:
# SITE_LEARNING_DIR=/var/lib/wangke-site/daily-learning
# SITE_TASK_PROMPT_FILE=/var/lib/wangke-site/documents/daily-task-prompt.md
# SITE_STATIC_DIR=/opt/wangke-site/current/dist
