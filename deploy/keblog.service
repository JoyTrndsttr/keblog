[Unit]
Description=keblog website and document API
After=network.target

[Service]
Type=simple
User=wangke-site
Group=wangke-site
EnvironmentFile=/etc/keblog.env
WorkingDirectory=/opt/keblog
ExecStart=/usr/bin/python3 /opt/keblog/server/content_server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/keblog/content /var/lib/wangke-site/research-cache

[Install]
WantedBy=multi-user.target
