[Unit]
Description=keblog website and document API
After=network.target

[Service]
Type=simple
User=wangke-site
Group=wangke-site
UMask=007
EnvironmentFile=/etc/keblog.env
Environment=RESEARCH_DOCUMENT_FILE=/var/lib/wangke-site/research-cache/research-record.md
Environment=RESEARCH_WORKBENCH_DIR=/var/lib/wangke-site/research-cache/workbench
Environment=KEBLOG_DB_PATH=/var/lib/wangke-site/keblog-data/community.sqlite3
Environment=KEBLOG_COOKIE_SECURE=1
WorkingDirectory=/opt/keblog
ExecStart=/usr/bin/python3 /opt/keblog/server/content_server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/keblog/content /var/lib/wangke-site/research-cache
ReadWritePaths=/var/lib/wangke-site/keblog-data

[Install]
WantedBy=multi-user.target
