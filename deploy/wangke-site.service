[Unit]
Description=Wang Ke personal research site
After=network.target

[Service]
Type=simple
User=wangke-site
Group=wangke-site
EnvironmentFile=/etc/wangke-site.env
WorkingDirectory=/opt/wangke-site/current
ExecStart=/usr/bin/python3 /opt/wangke-site/current/server/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wangke-site
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
